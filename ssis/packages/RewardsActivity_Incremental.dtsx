<?xml version="1.0" encoding="utf-8"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" DTS:ExecutableType="Microsoft.Package" DTS:ObjectName="RewardsActivity_Incremental" DTS:PackageType="5" DTS:ProtectionLevel="0">
  <DTS:Property DTS:Name="Description">DB2 rewards activity bounded-watermark load with reconciliation and cloud handoff.</DTS:Property>
  <DTS:Variables>
    <DTS:Variable DTS:Namespace="User" DTS:ObjectName="LowWatermark"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
    <DTS:Variable DTS:Namespace="User" DTS:ObjectName="HighWatermark"><DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue></DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable DTS:ObjectName="01 Capture Rewards Watermark" DTS:ExecutableType="Microsoft.ExecuteSQLTask" />
    <DTS:Executable DTS:ObjectName="02 DB2 Rewards Data Flow" DTS:ExecutableType="Microsoft.Pipeline" />
    <DTS:Executable DTS:ObjectName="03 Tokenization and DQ" DTS:ExecutableType="Microsoft.ExecuteSQLTask" />
    <DTS:Executable DTS:ObjectName="04 Merge Reward Fact" DTS:ExecutableType="Microsoft.ExecuteSQLTask" />
    <DTS:Executable DTS:ObjectName="05 Reconcile Points and Monetary Value" DTS:ExecutableType="Microsoft.ExecuteSQLTask" />
  </DTS:Executables>
</DTS:Executable>
