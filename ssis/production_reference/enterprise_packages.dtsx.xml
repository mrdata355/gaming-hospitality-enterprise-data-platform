  <Package name="PKG_HOTELRESERVATIONS_INCREMENTAL" source="DB2_HOSPITALITY" entity="HOSPITALITY.RESERVATION" restartable="true">
    <Variables>
      <Variable name="RunId" expression="@ExecutionInstanceGUID" />
      <Variable name="LowWatermark" default="0" />
      <Variable name="HighWatermark" default="0" />
      <Variable name="SourceCount" default="0" />
      <Variable name="LandingCount" default="0" />
      <Variable name="QuarantineCount" default="0" />
      <Variable name="DuplicateCount" default="0" />
      <Variable name="StaleCount" default="0" />
    </Variables>
    <ControlFlow>
      <Task sequence="1" name="AcquireRunLock" type="ExecuteSQL" connection="CM_SQLSERVER_CONTROL">
        <Sql>EXEC ctl.usp_begin_pipeline ?, ?, ?, ?, ?, ?</Sql>
        <OnError action="audit-and-fail" />
      </Task>
      <Task sequence="2" name="ReadWatermark" type="ExecuteSQL" connection="CM_SQLSERVER_CONTROL" dependsOn="AcquireRunLock">
        <Sql>SELECT low_watermark, high_watermark FROM ctl.pipeline_watermark WHERE pipeline_name=? AND source_system=?</Sql>
        <OnError action="audit-and-fail" />
      </Task>
      <Task sequence="3" name="ExtractDB2" type="DataFlow" dependsOn="ReadWatermark">
        <Retry count="3" seconds="30" />
        <OnError action="redirect-to-audit-and-fail" />
      </Task>
      <Task sequence="4" name="ValidateContract" type="ScriptTask" dependsOn="ExtractDB2">
        <Script>validate required keys, dates, property code, amounts, source version</Script>
      </Task>
      <Task sequence="5" name="WriteLanding" type="DataFlow" dependsOn="ValidateContract">
        <Destination>hotel/reservation/business_date={BusinessDate}/run_id={RunId}/</Destination>
      </Task>
      <Task sequence="6" name="QuarantineRejects" type="DataFlow" dependsOn="ValidateContract">
        <Destination>quarantine/hotel/reservation/reason={ReasonCode}/run_id={RunId}/</Destination>
      </Task>
      <Task sequence="7" name="ReconcileCounts" type="ExecuteSQL" connection="CM_SQLSERVER_CONTROL" dependsOn="WriteLanding">
        <Sql>EXEC audit.usp_reconcile_run ?, ?, ?, ?, ?, ?</Sql>
      </Task>
      <Task sequence="8" name="PublishReadyEvent" type="ScriptTask" dependsOn="ReconcileCounts">
        <Event topic="hotel.reservation-events.v1" type="LANDING_READY" />
      </Task>
      <Task sequence="9" name="CommitWatermark" type="ExecuteSQL" connection="CM_SQLSERVER_CONTROL" dependsOn="PublishReadyEvent">
        <Sql>EXEC ctl.usp_commit_pipeline ?, ?, ?, ?, ?, ?, ?, ?, ?, ?</Sql>
      </Task>
      <Task sequence="10" name="ReleaseRunLock" type="ExecuteSQL" connection="CM_SQLSERVER_CONTROL" dependsOn="CommitWatermark">
        <Sql>EXEC ctl.usp_end_pipeline ?, 'SUCCEEDED'</Sql>
      </Task>
    </ControlFlow>
    <DataFlow name="DFT_HOTEL_RESERVATIONS">
      <Component sequence="1" name="DB2Source" type="OLEDBSource">
        <Query>SELECT * FROM HOSPITALITY.RESERVATION WHERE UPDATED_SCN &gt; ? AND UPDATED_SCN &lt;= ? WITH UR</Query>
      </Component>
      <Component sequence="2" name="RowCountSource" type="RowCount" variable="SourceCount" />
      <Component sequence="3" name="NormalizeCodes" type="DerivedColumn">
        <Expression column="PROPERTY_CODE">UPPER(TRIM(PROPERTY_CODE))</Expression>
        <Expression column="STATUS_CD">UPPER(TRIM(STATUS_CD))</Expression>
        <Expression column="ROOM_TYPE_CD">UPPER(TRIM(ROOM_TYPE_CD))</Expression>
      </Component>
      <Component sequence="4" name="ValidateBusinessKey" type="ConditionalSplit">
        <Output name="Valid">!ISNULL(RESERVATION_ID) &amp;&amp; !ISNULL(PROPERTY_CODE)</Output>
        <Output name="Rejected">ISNULL(RESERVATION_ID) || ISNULL(PROPERTY_CODE)</Output>
      </Component>
      <Component sequence="5" name="ValidateStayDates" type="ConditionalSplit">
        <Output name="ValidDates">ARRIVAL_DATE &lt;= DEPARTURE_DATE</Output>
        <Output name="InvalidDates">ARRIVAL_DATE &gt; DEPARTURE_DATE</Output>
      </Component>
      <Component sequence="6" name="ValidateAmounts" type="ConditionalSplit">
        <Output name="ValidAmounts">ROOM_QTY &gt;= 0 &amp;&amp; REVENUE_AMT &gt;= 0</Output>
        <Output name="InvalidAmounts">ROOM_QTY &lt; 0 || REVENUE_AMT &lt; 0</Output>
      </Component>
      <Component sequence="7" name="LandingWriter" type="FlatFileDestination" path="hotel/reservation" />
      <Component sequence="8" name="QuarantineWriter" type="FlatFileDestination" path="quarantine/hotel/reservation" />
      <Component sequence="9" name="RowCountLanding" type="RowCount" variable="LandingCount" />
      <Component sequence="10" name="RowCountQuarantine" type="RowCount" variable="QuarantineCount" />
    </DataFlow>
    <Logging>
      <Event name="OnPreExecute" destination="audit.pipeline_run" />
      <Event name="OnPostExecute" destination="audit.pipeline_run" />
      <Event name="OnError" destination="audit.pipeline_run" />
      <Event name="OnWarning" destination="audit.pipeline_run" />
      <Event name="PipelineRowsSent" destination="audit.pipeline_run" />
      <Event name="Diagnostic" destination="audit.pipeline_run" />
    </Logging>
  </Package>

