<PortfolioSSISReference version="1.0">
  <Parameters>
    <Parameter name="Environment" dataType="String" default="DEV" />
    <Parameter name="SourceLowWatermark" dataType="Int64" default="0" />
    <Parameter name="SourceHighWatermark" dataType="Int64" default="0" />
    <Parameter name="LandingRoot" dataType="String" default="\\synthetic\landing" />
    <Parameter name="GcsLandingPrefix" dataType="String" default="gs://vh-portfolio-dev-landing-us-west1" />
    <Parameter name="SqlControlConnection" dataType="String" default="PortfolioControl" />
    <Parameter name="FailOnReconciliationDifference" dataType="Boolean" default="true" />
    <Parameter name="RetryCount" dataType="Int32" default="3" />
    <Parameter name="RetrySeconds" dataType="Int32" default="30" />
  </Parameters>
  <Connections>
    <Connection name="CM_DB2_HOSPITALITY" type="OLEDB" secretReference="kv/db2-hospitality" />
    <Connection name="CM_DB2_GAMING" type="OLEDB" secretReference="kv/db2-gaming" />
    <Connection name="CM_DB2_LOYALTY" type="OLEDB" secretReference="kv/db2-loyalty" />
    <Connection name="CM_SQLSERVER_FINANCE" type="ADO.NET" secretReference="kv/sql-finance" />
    <Connection name="CM_SQLSERVER_CONTROL" type="ADO.NET" secretReference="kv/sql-control" />
